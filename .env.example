# Copy this file to .env and adjust. These are the LOCAL PILOT defaults —
# throwaway values for a laptop practice run. On any real box the deploy
# ceremony mints real credentials and OpenBao holds them (see REFCARD_credentials.md).

# --- Deployment posture (d.s Stage 1-3) --------------------------------------
# KH_POSTURE=local | deployed.  DEFAULT IS local: absent, unset, or blank all
# resolve to local, and every run prints which posture it is on.
#
#   local     internal, single-user. No kit signing, no arrival gate, no
#             unseal-share custody ceremony. Credentials come from
#             .secrets.local.json (see .secrets.local.example.json), so nothing
#             needs OpenBao to start, run, or ingest, and the operator console
#             logs itself in with no credential to record or paste.
#             `khctl make-kit` REFUSES in this posture — a kit runs on another
#             machine and must carry the hardened path.
#   deployed  the full hardened path, unchanged: signed kits, the arrival gate,
#             the custody ceremony, and OpenBao holding every credential.
#
# It is a SWITCH, not a deletion — the hardened path is intact and one setting
# away. Deliberately NOT called a "profile": --profile / profiles.toml already
# name the commercial offering (appliance | client-gpu | hosted).
#
# An unrecognized value is an ERROR, not a fallback. Reading KH_POSTURE=prod as
# "local" would ship a soft build from someone who believed they had hardened it.
#
# Commented out because unset already means local. Uncomment to harden, or set
# it per command:  KH_POSTURE=deployed khctl make-kit ...
#KH_POSTURE=deployed

# Where local-posture credentials live (source credentials + the console
# principal registry). Relative to the working directory. Gitignored, and
# refused by the kit's no-secrets guard so it can never leave this box.
#KH_LOCAL_SECRETS_FILE=.secrets.local.json

# Service credentials for the local pilot. Docker Compose reads this automatically.
POSTGRES_USER=kh
POSTGRES_PASSWORD=kh_pilot_pw
POSTGRES_DB=knowledge_hub

# SeaweedFS S3 gateway. These MUST match seaweedfs/s3config.json.
# Used by the Python client (boto3).
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=kh_s3_admin
S3_SECRET_KEY=kh_s3_secret_pw
S3_RAW_BUCKET=kh-raw

# OpenBao (dev mode). The root token is a dev-only convenience — never do this in prod.
# Read in DEPLOYED posture only: with KH_POSTURE unset or local, credentials come
# from .secrets.local.json and these two are never contacted.
BAO_ADDR=http://localhost:8200
BAO_ROOT_TOKEN=kh_pilot_root_token

# --- Least-privilege Postgres roles (§8.8 isolation) -------------------------
# POSTGRES_USER above is the BOOTSTRAP account: it owns the schema, runs
# migrations, and creates the four roles below. Runtime consumers must NOT use
# it — each of the trusted services connects under its own role so the database
# can tell them apart, and so `kh_serving` is SELECT-only by GRANT rather than
# by a session setting the client puts on itself.
#
#   kh_pipeline   read/write  — the ingest path (PostgresFactStore)
#   kh_serving    SELECT only — the read boundary on :8080
#   kh_operator   read/write  — the operator console on :8081, audited
#   kh_report     SELECT only — reporting scripts and the verifier
#
# `khctl plan` MINTS these; a re-plan preserves whatever a live box already
# holds so rotation is never a side effect. They are commented out here
# because a committed default would be a guessable credential on every
# deployment: leave them unset and each role is created NOLOGIN, every
# consumer falls back to the bootstrap account with a WARNING, and
# `check_side_doors` fails until they are provisioned.
#KH_PG_PIPELINE_PASSWORD=
#KH_PG_SERVING_PASSWORD=
#KH_PG_OPERATOR_PASSWORD=
#KH_PG_REPORT_PASSWORD=

# Where served-envelope usage records go: postgres (default, migration 019) or
# jsonl. Postgres is what makes "did principal X read through ops?" a query.
# An unrecognized value is an ERROR, not a fallback.
#SERVING_USAGE_SINK=postgres
