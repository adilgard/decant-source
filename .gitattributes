# Normalize text files; pin endings where the runtime cares.
* text=auto

# Anything executed on the Ubuntu boxes must stay LF
*.sh text eol=lf
Dockerfile text eol=lf
*.hcl text eol=lf

# Windows batch files must stay CRLF
*.cmd text eol=crlf

# Binary — never touch
*.docx binary
*.xlsx binary

# Git hooks execute under sh (Git for Windows' sh.exe on this bench), so a CRLF
# shebang would break them on checkout. The hook shim has no .sh extension, so
# the rule above does not reach it.
hooks/pre-commit text eol=lf
